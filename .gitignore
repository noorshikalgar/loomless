# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Go (capture engine candidate) ---
/bin/
/dist/
/loomless
*.exe
*.test
*.out

# --- Rust (capture engine candidate) ---
/target/
Cargo.lock

# --- Node (local editor / renderer candidate) ---
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Loomless's own local session data (never commit raw captures) ---
.loomless/
*.loomless-session/
